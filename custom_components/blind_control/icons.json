          "rule": "mdi:calendar-clock",
          "oversteer": "mdi:weather-partly-cloudy",
          "sun": "mdi:weather-sunny",
          "default": "mdi:roller-shade"
        }
      },
      "reason": { "default": "mdi:information-outline" },
      "target_position": { "default": "mdi:roller-shade" },
      "next_action": { "default": "mdi:clock-outline" },
      "next_action_summary": { "default": "mdi:calendar-arrow-right" },
      "override_expires": { "default": "mdi:timer-sand" },
      "sun_shade_position": { "default": "mdi:sun-angle" }
    },
    "binary_sensor": {
      "sun_in_window": {
        "default": "mdi:weather-sunny-off",
        "state": { "on": "mdi:weather-sunny" }
